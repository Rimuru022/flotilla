# Copia este archivo a .env (está en .gitignore) y llena lo que uses.

# Asistente: clave de OpenRouter. Sin ella el resto de la app funciona y el asistente se muestra desactivado.
OPENROUTER_API_KEY=

# Modelo del asistente (cualquier modelo de OpenRouter con tool use).
# Por defecto uno económico; para Claude usa por ejemplo anthropic/claude-haiku-5.5 o anthropic/claude-sonnet-5.5.
FLOTILLA_MODELO=deepseek/deepseek-v4-flash

# Demo público: regenera la base al arrancar y cada madrugada con la fecha de hoy como corte.
DEMO_MODE=0

# Límites del asistente en el demo (cada pregunta cuesta tokens).
ASISTENTE_LIMITE_VISITANTE=15
ASISTENTE_LIMITE_DIARIO=300

# Ruta de la base (por defecto data/flotilla.db).
# FLOTILLA_DB=data/flotilla.db
